GPIO5.$name                         = "GPIO_GW";
GPIO5.associatedPins.create(3);
GPIO5.associatedPins[0].$name       = "PIN_0";
GPIO5.associatedPins[1].$name       = "PIN_1";
GPIO5.associatedPins[1].pin.$assign = "PA24";
GPIO5.associatedPins[2].$name       = "PIN_2";
