UART1.targetBaudRate                       = 115200;
UART1.$name                                = "Imu";
UART1.enabledDMARXTriggers                 = "DL_UART_DMA_INTERRUPT_RX";
UART1.enabledInterrupts                    = ["DMA_DONE_RX","TX"];
